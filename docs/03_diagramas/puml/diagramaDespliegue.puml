@startuml Diagrama_Despliegue_Maflow

left to right direction

title Diagrama de Despliegue — Maflow RPA System

'=== CLIENTE ===
node "PC de Planta\n[Navegador Web]" as CLIENT {
    component "Interfaz Web\n[React]" as UI
}

'=== SERVIDOR APLICACIÓN + RPA ===
node "Servidor Aplicación / RPA\n[Windows Server]" as SRV_APP {
    component "API REST [Node.js/Express]" as API
    component "Middleware JWT" as JWT
    component "Controllers" as CTRL
    component "Launcher RPA [.bat]" as BAT

    node "UiPath Robot" as RPA {
        component "Login SAP" as RPA_LOGIN
        component "Procesar Declaraciones" as RPA_PROC
        component "Cambio Contraseña Auto." as RPA_PASS
        component "Logging y Auditoría" as RPA_LOG
    }
}

'=== SERVIDOR BIGDATA ===
node "Servidor BigData\n[Windows Server]" as SRV_BD {
    database "SQL Server" as DB {
        artifact "Declaraciones (estados 0/1/2)" as TBL_DECL
        artifact "Credenciales SAP" as TBL_CRED
        artifact "Órdenes / Referencias" as TBL_ORDERS
        artifact "Usuarios / Roles" as TBL_USERS
    }
    component "Sistema MES" as MES {
        component "API Declaración Piezas" as MES_API
        database "BD Puestos/Órdenes" as MES_DB
    }
}

'=== SERVIDOR SAP ===
node "Servidor SAP\n[SAP ERP/ECC]" as SRV_SAP {
    component "SAP GUI" as SAP_GUI
    component "CO11N - Confirmación Órdenes" as CO11N
    component "SU3 - Gestión Contraseña" as SU3
    component "Impresión Galia [ETI-9]" as SAP_PRINT
}

'=== IMPRESORA ===
node "Impresora Etiquetas\n[Planta]" as PRINTER {
    artifact "Etiqueta Galia (ETI-9)" as LABEL
}

'=== CONEXIONES ===
CLIENT --> SRV_APP  : "HTTPS / REST"
SRV_APP --> SRV_BD  : "SQL + HTTP (MES)"
RPA --> SRV_BD      : "SQL\n(estado 0→1/2)"
RPA --> SRV_SAP     : "SAP GUI\nAutomation"
SRV_SAP --> PRINTER : "Spooler\nRed local"

@enduml
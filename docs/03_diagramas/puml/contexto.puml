@startuml Contexto
title Diagrama de Contexto - Sistema RPA Maflow

skinparam actorStyle awesome
left to right direction

actor "Operario" as operario
actor "Responsable" as responsable
actor "Administrador" as admin
actor "Robot RPA" as robot <<System>>
actor "Administrador SAP" as admin_sap

package "Sistema RPA Maflow" {
    package "Pantalla de Declaración" {
        usecase "Registrar Declaración" as UC1
        usecase "Enviar a SAP" as UC2
        usecase "Consultar Log Propio" as UC3
    }

    package "Pantalla Log Completo" {
        usecase "Gestionar Registros" as UC4
        usecase "Consultar Log Completo" as UC5
    }

    package "Pantalla Gestión de Usuarios" {
        usecase "Gestionar Usuarios" as UC6
    }

    package "Procesos de Sistema / Robot" {
        usecase "Procesar Declaración (SAP GUI)" as UC8
        usecase "Cambio de Contraseña Automático" as UC9
        usecase "Desbloquear Cuenta SAP" as UC10
        usecase "Imprimir Etiqueta Galia" as UC11
    }
}

database "Sistemas Externos" {
    entity "SAP ERP" as sap
    entity "MES" as mes
}

' Relaciones de Operario
operario --> UC1
operario --> UC2
operario --> UC3

' Relaciones de Responsable
responsable --> UC4
responsable --> UC5
responsable --> UC3

' Relaciones de Administrador (Acceso total)
admin --> UC1
admin --> UC2
admin --> UC3
admin --> UC4
admin --> UC5
admin --> UC6

' Relaciones de Administrador SAP
admin_sap --> UC10

' Relaciones de Robot RPA
robot --> UC8
robot --> UC9

' Interacciones con Sistemas Externos
UC8 -- sap
UC1 -- mes
sap --> UC11 : "Genera e imprime"

note right of robot
  El Robot actúa como un actor de sistema
  que ejecuta tareas sobre SAP GUI
  basado en las peticiones de la interfaz.
end note

@enduml
